# Image B: multi-stage. Builds in golang:1.18, ships only the binary on debian:trixie-slim (Debian 13).
# One change from A: the runtime image. The build stage is identical, so it comes from the cache.
# Build from the repo folder:  docker build -t hello:b -f dockerfiles/Dockerfile.b-multi ./go

# Stage 1: build (thrown away after the build)
FROM golang:1.18 AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o hello-server .

# Stage 2: runtime (the only stage that ships)
FROM debian:trixie-slim
# Only the static binary crosses over: no compiler, no git, no source, no module cache
COPY --from=build /app/hello-server /usr/local/bin/hello-server
# Non-root by number. 65532 has no /etc/passwd entry here, so its group is 0 (root): USER 65532:65532 would fix that
USER 65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/hello-server"]
