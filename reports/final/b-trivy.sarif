            {
              "id": "CVE-2026-94448",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "html/template: golang: golang: cross-site scripting via consecutive expressions in JavaScript template literals"
              },
              "fullDescription": {
                "text": "When a JavaScript template literal contains consecutive expressions, the context tracking state was not properly reset upon entering a new expression. We now ensure that template-literal expression entries correctly reset context variables so all subsequent regular expression literals are accurately recognized and escaped."
