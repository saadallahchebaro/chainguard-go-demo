              "help": {
                "text": "Vulnerability CVE-2026-97031\nSeverity: high\nPackage: stdlib\nVersion: go1.18.10\nFix Version: 1.26.9,1.27.2\nType: go-module\nLocation: /usr/local/bin/hello-server\nData Namespace: govulndb:language:go\nLink: [CVE-2026-97031](https://go.dev/cl/847312)",
