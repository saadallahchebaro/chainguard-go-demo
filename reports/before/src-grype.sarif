              "id": "CVE-2026-33814-golang.org/x/net",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-33814 high vulnerability for golang.org/x/net package"
              },
              "fullDescription": {
