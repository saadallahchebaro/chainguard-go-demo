            },
            {
              "id": "CVE-2026-56855-golang.org/x/crypto",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-56855 high vulnerability for golang.org/x/crypto package"
              },
              "fullDescription": {
                "text": "Previously, after a channel has been established, a malicious peer could send crafted messages that would deadlock the entire connection.\n\nNow, we handle all RFC 4254 channel messages; global requests are handled explicitly. Then, treat all other messages as a protocol error and tear the connection down instead of buffering and blocking."
              },
              "helpUri": "https://go.dev/issue/81317",
              "help": {
                "text": "Vulnerability CVE-2026-56855\nSeverity: high\nPackage: golang.org/x/crypto\nVersion: v0.0.0-20210711020723-a769d52b0f97\nFix Version: 0.56.0\nType: go-module\nLocation: /go.mod\nData Namespace: govulndb:language:go\nLink: [CVE-2026-56855](https://go.dev/issue/81317)",
