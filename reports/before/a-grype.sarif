              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libldap-2.4-2@2.4.57%2Bdfsg-3%2Bdeb11u1?arch=arm64\u0026distro=debian-11.6\u0026upstream=openldap"
                ],
                "security-severity": "4.6"
              }
            },
            {
              "id": "CVE-2026-15003-binutils",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-15003 low vulnerability for binutils package"
              },
              "fullDescription": {
                "text": "A flaw was found in the GNU Binutils (Binary Utilities) linker. This vulnerability, a heap-buffer-overflow read (CWE-125), occurs when the linker processes a specially crafted 32-bit XCOFF (Extended Common Object File Format) object file. An attacker could exploit this by providing a malicious file, leading to an out-of-bounds read of memory. This can result in information disclosure, potentially revealing sensitive heap data, and a Denial of Service (DoS) due to the linker crashing."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-15003",
              "help": {
                "text": "Vulnerability CVE-2026-15003\nSeverity: low\nPackage: binutils\nVersion: 2.35.2-2\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-15003](https://security-tracker.debian.org/tracker/CVE-2026-15003)",
