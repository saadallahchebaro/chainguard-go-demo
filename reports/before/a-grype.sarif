            {
              "id": "CVE-2026-27142-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-27142 medium vulnerability for go package"
              },
              "fullDescription": {
                "text": "Actions which insert URLs into the content attribute of HTML meta tags are not escaped. This can allow XSS if the meta tag also has an http-equiv attribute with the value \"refresh\". A new GODEBUG setting has been added, htmlmetacontenturlescape, which can be used to disable escaping URLs in actions in the meta content attribute which follow \"url=\" by setting htmlmetacontenturlescape=0."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-27142",
              "help": {
                "text": "Vulnerability CVE-2026-27142\nSeverity: medium\nPackage: go\nVersion: 1.18.10\nFix Version: 1.25.8,1.26.1\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2026-27142](https://nvd.nist.gov/vuln/detail/CVE-2026-27142)",
