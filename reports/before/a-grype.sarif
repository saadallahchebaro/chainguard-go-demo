            {
              "id": "CVE-2024-8096-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2024-8096 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When curl is told to use the Certificate Status Request TLS extension, often referred to as OCSP stapling, to verify that the server certificate is valid, it might fail to detect some OCSP problems and instead wrongly consider the response as fine.  If the returned status reports another error than 'revoked' (like for example 'unauthorized') it is not treated as a bad certficate."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2024-8096",
              "help": {
                "text": "Vulnerability CVE-2024-8096\nSeverity: medium\nPackage: curl\nVersion: 7.74.0-1.3+deb11u3\nFix Version: 7.74.0-1.3+deb11u14\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2024-8096](https://security-tracker.debian.org/tracker/CVE-2024-8096)",
