              }
            },
            {
              "id": "CVE-2025-49506-libaprutil1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2025-49506 high vulnerability for libaprutil1 package"
              },
              "fullDescription": {
                "text": "APR-util versions 1.6.3 (and earlier) function apr_password_validate() was not constant-time with regards to hashes or passwords comparisons, potentially leaking their content via a side channel timing attack particularly on platforms without crypt() such as  Windows, BeOS, NetWare, or Android.  Users are recommended to upgrade to version 1.6.4, which fixes this issue."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2025-49506",
              "help": {
                "text": "Vulnerability CVE-2025-49506\nSeverity: high\nPackage: libaprutil1\nVersion: 1.6.1-5\nFix Version: 1.6.1-5+deb11u2\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2025-49506](https://security-tracker.debian.org/tracker/CVE-2025-49506)",
