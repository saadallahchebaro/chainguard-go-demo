            {
              "id": "CVE-2026-40356-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-40356 high vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "In MIT Kerberos 5 (aka krb5) before 1.22.3, there is an integer underflow and resultant out-of-bounds read if an application calls gss_accept_sec_context() on a system with a NegoEx mechanism registered in /etc/gss/mech. An unauthenticated remote attacker can trigger this, possibly causing the process to terminate in parse_message."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-40356",
              "help": {
                "text": "Vulnerability CVE-2026-40356\nSeverity: high\nPackage: libgssapi-krb5-2\nVersion: 1.18.3-6+deb11u3\nFix Version: 1.18.3-6+deb11u8\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-40356](https://security-tracker.debian.org/tracker/CVE-2026-40356)",
