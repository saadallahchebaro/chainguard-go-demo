            {
              "id": "CVE-2026-3784-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-3784 medium vulnerability for curl package"
              },
              "fullDescription": {
                "text": "curl would wrongly reuse an existing HTTP proxy connection doing CONNECT to a server, even if the new request uses different credentials for the HTTP proxy. The proper behavior is to create or use a separate connection."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-3784",
