            {
              "id": "CVE-2026-35385-openssh-client",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-35385 high vulnerability for openssh-client package"
              },
              "fullDescription": {
                "text": "In OpenSSH before 10.3, a file downloaded by scp may be installed setuid or setgid, an outcome contrary to some users' expectations, if the download is performed as root with -O (legacy scp protocol) and without -p (preserve mode)."
