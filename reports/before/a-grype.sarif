            {
              "id": "CVE-2026-6276-libcurl3-gnutls",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-6276 high vulnerability for libcurl3-gnutls package"
              },
              "fullDescription": {
                "text": "Using libcurl, when a custom `Host:` header is first set for an HTTP request and a second request is subsequently done using the same *easy handle* but without the custom `Host:` header set, the second request would use stale information and pass on cookies meant for the first host in the second request. Leak them."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-6276",
              "help": {
                "text": "Vulnerability CVE-2026-6276\nSeverity: high\nPackage: libcurl3-gnutls\nVersion: 7.74.0-1.3+deb11u3\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-6276](https://security-tracker.debian.org/tracker/CVE-2026-6276)",
