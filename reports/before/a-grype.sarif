            {
              "id": "CVE-2025-24528-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2025-24528 high vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
