              }
            },
            {
              "id": "CVE-2025-32988-libgnutls30",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2025-32988 high vulnerability for libgnutls30 package"
              },
              "fullDescription": {
                "text": "A flaw was found in GnuTLS. A double-free vulnerability exists in GnuTLS due to incorrect ownership handling in the export logic of Subject Alternative Name (SAN) entries containing an otherName. If the type-id OID is invalid or malformed, GnuTLS will call asn1_delete_structure() on an ASN.1 node it does not own, leading to a double-free condition when the parent function or caller later attempts to free the same structure.  This vulnerability can be triggered using only public GnuTLS APIs and may result in denial of service or memory corruption, depending on allocator behavior."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2025-32988",
              "help": {
                "text": "Vulnerability CVE-2025-32988\nSeverity: high\nPackage: libgnutls30\nVersion: 3.7.1-5+deb11u2\nFix Version: 3.7.1-5+deb11u8\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2025-32988](https://security-tracker.debian.org/tracker/CVE-2025-32988)",
                "markdown": "**Vulnerability CVE-2025-32988**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | libgnutls30  | 3.7.1-5+deb11u2  | 3.7.1-5+deb11u8  | deb  | /var/lib/dpkg/status  | debian:distro:debian:11  | [CVE-2025-32988](https://security-tracker.debian.org/tracker/CVE-2025-32988)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libgnutls30@3.7.1-5%2Bdeb11u2?arch=arm64\u0026distro=debian-11.6\u0026upstream=gnutls28"
                ],
                "security-severity": "8.2"
              }
