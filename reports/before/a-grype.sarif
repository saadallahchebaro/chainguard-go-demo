            {
              "id": "CVE-2025-61726-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-61726 high vulnerability for go package"
              },
              "fullDescription": {
                "text": "The net/url package does not set a limit on the number of query parameters in a query. While the maximum size of query parameters in URLs is generally limited by the maximum request header size, the net/http.Request.ParseForm method can parse large URL-encoded forms. Parsing a large form containing many unique query parameters can cause excessive memory consumption."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2025-61726",
              "help": {
                "text": "Vulnerability CVE-2025-61726\nSeverity: high\nPackage: go\nVersion: 1.18.10\nFix Version: 1.24.12,1.25.6\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2025-61726](https://nvd.nist.gov/vuln/detail/CVE-2025-61726)",
