            {
              "id": "CVE-2026-2297-libpython3.9-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-2297 low vulnerability for libpython3.9-minimal package"
              },
              "fullDescription": {
                "text": "The import hook in CPython that handles legacy *.pyc files (SourcelessFileLoader) is incorrectly handled in FileLoader (a base class) and so does not use io.open_code() to read the .pyc files. sys.audit handlers for this audit event therefore do not fire."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-2297",
              "help": {
                "text": "Vulnerability CVE-2026-2297\nSeverity: low\nPackage: libpython3.9-minimal\nVersion: 3.9.2-1\nFix Version: 3.9.2-1+deb11u7\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-2297](https://security-tracker.debian.org/tracker/CVE-2026-2297)",
