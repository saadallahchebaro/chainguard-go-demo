            {
              "id": "CVE-2023-54365-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2023-54365 high vulnerability for go package"
              },
              "fullDescription": {
                "text": "Traefik before 2.10.5 and 3.0.0-beta4 is affected by a denial-of-service vulnerability in HTTP/2 request handling inherited from the Go standard library's HTTP/2 implementation (CVE-2023-44487 / CVE-2023-39325, the 'Rapid Reset' technique). A remote attacker can rapidly create and cancel HTTP/2 streams to exhaust server resources and cause service unavailability."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2023-54365",
