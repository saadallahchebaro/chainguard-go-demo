            {
              "id": "CVE-2025-58183-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-58183 medium vulnerability for go package"
              },
              "fullDescription": {
                "text": "tar.Reader does not set a maximum size on the number of sparse region data blocks in GNU tar pax 1.0 sparse files. A maliciously-crafted archive containing a large number of sparse regions can cause a Reader to read an unbounded amount of data from the archive into memory. When reading from a compressed source, a small compressed input can result in large allocations."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2025-58183",
              "help": {
                "text": "Vulnerability CVE-2025-58183\nSeverity: medium\nPackage: go\nVersion: 1.18.10\nFix Version: 1.24.8,1.25.2\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2025-58183](https://nvd.nist.gov/vuln/detail/CVE-2025-58183)",
