            {
              "id": "CVE-2026-42015-libgnutls30",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-42015 medium vulnerability for libgnutls30 package"
              },
              "fullDescription": {
                "text": "A flaw was found in gnutls. An off-by-one error exists in the PKCS#12 bag element bounds check. This vulnerability allows an remote attacker to write past the internal array of a PKCS#12 bag when appending to a bag that already contains 32 elements. This memory corruption could lead to a denial of service (DoS) or potentially other unspecified impacts."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-42015",
              "help": {
                "text": "Vulnerability CVE-2026-42015\nSeverity: medium\nPackage: libgnutls30\nVersion: 3.7.1-5+deb11u2\nFix Version: 3.7.1-5+deb11u10\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-42015](https://security-tracker.debian.org/tracker/CVE-2026-42015)",
