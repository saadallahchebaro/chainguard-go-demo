            {
              "id": "CVE-2026-32281-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-32281 high vulnerability for go package"
              },
              "fullDescription": {
                "text": "Validating certificate chains which use policies is unexpectedly inefficient when certificates in the chain contain a very large number of policy mappings, possibly causing denial of service. This only affects validation of otherwise trusted certificate chains, issued by a root CA in the VerifyOptions.Roots CertPool, or in the system certificate pool."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-32281",
              "help": {
                "text": "Vulnerability CVE-2026-32281\nSeverity: high\nPackage: go\nVersion: 1.18.10\nFix Version: 1.25.9,1.26.2\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2026-32281](https://nvd.nist.gov/vuln/detail/CVE-2026-32281)",
