              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libp11-kit0@0.23.22-1?arch=arm64\u0026distro=debian-11.6\u0026upstream=p11-kit"
                ],
                "security-severity": "6.2"
              }
