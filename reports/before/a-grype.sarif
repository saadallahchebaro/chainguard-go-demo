            {
              "id": "CVE-2013-4392-libudev1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2013-4392 low vulnerability for libudev1 package"
              },
              "fullDescription": {
