            {
              "id": "CVE-2023-40217-libpython3.9-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-40217 medium vulnerability for libpython3.9-minimal package"
              },
              "fullDescription": {
                "text": "An issue was discovered in Python before 3.8.18, 3.9.x before 3.9.18, 3.10.x before 3.10.13, and 3.11.x before 3.11.5. It primarily affects servers (such as HTTP servers) that use TLS client authentication. If a TLS server-side socket is created, receives data into the socket buffer, and then is closed quickly, there is a brief window where the SSLSocket instance will detect the socket as \"not connected\" and won't initiate a handshake, but buffered data will still be readable from the socket buffer. This data will not be authenticated if the server-side TLS peer is expecting client certificate authentication, and is indistinguishable from valid TLS stream data. Data is limited in size to the amount that will fit in the buffer. (The TLS connection cannot directly be used for data exfiltration because the vulnerable code path requires that the connection be closed on initialization of the SSLSocket.)"
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2023-40217",
              "help": {
                "text": "Vulnerability CVE-2023-40217\nSeverity: medium\nPackage: libpython3.9-minimal\nVersion: 3.9.2-1\nFix Version: 3.9.2-1+deb11u2\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2023-40217](https://security-tracker.debian.org/tracker/CVE-2023-40217)",
                "markdown": "**Vulnerability CVE-2023-40217**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | libpython3.9-minimal  | 3.9.2-1  | 3.9.2-1+deb11u2  | deb  | /var/lib/dpkg/status  | debian:distro:debian:11  | [CVE-2023-40217](https://security-tracker.debian.org/tracker/CVE-2023-40217)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libpython3.9-minimal@3.9.2-1?arch=arm64\u0026distro=debian-11.6\u0026upstream=python3.9"
                ],
                "security-severity": "5.3"
              }
            },
