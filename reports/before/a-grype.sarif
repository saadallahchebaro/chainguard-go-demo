            {
              "id": "CVE-2026-42009-libgnutls30",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-42009 high vulnerability for libgnutls30 package"
              },
              "fullDescription": {
                "text": "A flaw was found in gnutls. A remote attacker could exploit an issue in the Datagram Transport Layer Security (DTLS) packet reordering logic. The comparator function, responsible for ordering DTLS packets by sequence numbers, did not correctly handle packets with duplicate sequence numbers. This could lead to unstable packet ordering or undefined behavior, resulting in a denial of service."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-42009",
              "help": {
                "text": "Vulnerability CVE-2026-42009\nSeverity: high\nPackage: libgnutls30\nVersion: 3.7.1-5+deb11u2\nFix Version: 3.7.1-5+deb11u10\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-42009](https://security-tracker.debian.org/tracker/CVE-2026-42009)",
