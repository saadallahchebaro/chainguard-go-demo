            {
              "id": "CVE-2025-1795-libpython3.9-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2025-1795 low vulnerability for libpython3.9-minimal package"
              },
              "fullDescription": {
                "text": "During an address list folding when a separating comma ends up on a folded line and that line is to be unicode-encoded then the separator itself is also unicode-encoded. Expected behavior is that the separating comma remains a plan comma. This can result in the address header being misinterpreted by some mail servers."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2025-1795",
              "help": {
                "text": "Vulnerability CVE-2025-1795\nSeverity: low\nPackage: libpython3.9-minimal\nVersion: 3.9.2-1\nFix Version: 3.9.2-1+deb11u3\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2025-1795](https://security-tracker.debian.org/tracker/CVE-2025-1795)",
