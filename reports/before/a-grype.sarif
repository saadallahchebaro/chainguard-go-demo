            {
              "id": "CVE-2026-3446-libpython3.9-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-3446 medium vulnerability for libpython3.9-minimal package"
              },
              "fullDescription": {
                "text": "When calling base64.b64decode() or related functions the decoding process would stop after encountering the first padded quad regardless of whether there was more information to be processed. This can lead to data being accepted which may be processed differently by other implementations. Use \"validate=True\" to enable stricter processing of base64 data."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-3446",
              "help": {
                "text": "Vulnerability CVE-2026-3446\nSeverity: medium\nPackage: libpython3.9-minimal\nVersion: 3.9.2-1\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-3446](https://security-tracker.debian.org/tracker/CVE-2026-3446)",
