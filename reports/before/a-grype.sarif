            {
              "id": "CVE-2025-6297-dpkg",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2025-6297 high vulnerability for dpkg package"
              },
              "fullDescription": {
                "text": "It was discovered that dpkg-deb does not properly sanitize directory permissions when extracting a control member into a temporary directory, which is documented as being a safe operation even on untrusted data. This may result in leaving temporary files behind on cleanup. Given automated and repeated execution of dpkg-deb commands on adversarial .deb packages or with well compressible files, placed inside a directory with permissions not allowing removal by a non-root user, this can end up in a DoS scenario due to causing disk quota exhaustion or disk full conditions."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2025-6297",
              "help": {
                "text": "Vulnerability CVE-2025-6297\nSeverity: high\nPackage: dpkg\nVersion: 1.20.12\nFix Version: 1.20.14\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2025-6297](https://security-tracker.debian.org/tracker/CVE-2025-6297)",
                "markdown": "**Vulnerability CVE-2025-6297**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | dpkg  | 1.20.12  | 1.20.14  | deb  | /var/lib/dpkg/status  | debian:distro:debian:11  | [CVE-2025-6297](https://security-tracker.debian.org/tracker/CVE-2025-6297)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/dpkg@1.20.12?arch=arm64\u0026distro=debian-11.6"
                ],
                "security-severity": "8.2"
              }
            },
