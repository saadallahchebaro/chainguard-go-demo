            {
              "id": "CVE-2025-61730-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2025-61730 medium vulnerability for go package"
              },
              "fullDescription": {
                "text": "During the TLS 1.3 handshake if multiple messages are sent in records that span encryption level boundaries (for instance the Client Hello and Encrypted Extensions messages), the subsequent messages may be processed before the encryption level changes. This can cause some minor information disclosure if a network-local attacker can inject messages during the handshake."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2025-61730",
              "help": {
                "text": "Vulnerability CVE-2025-61730\nSeverity: medium\nPackage: go\nVersion: 1.18.10\nFix Version: 1.24.12,1.25.6\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2025-61730](https://nvd.nist.gov/vuln/detail/CVE-2025-61730)",
