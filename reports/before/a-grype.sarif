            {
              "id": "CVE-2026-111943-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-111943 medium vulnerability for go package"
              },
              "fullDescription": {
                "text": "On most platforms, Go uses the given system root certificates. However, in some narrower cases, the system trust stores may not be updated without further action. To defend against the narrower set of cases that may remain affected, a denylist was added in crypto/x509 to return an error when calling Verify with any of the known intermediate certificates that are no longer considered to be trustworthy."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-111943",
              "help": {
                "text": "Vulnerability CVE-2026-111943\nSeverity: medium\nPackage: go\nVersion: 1.18.10\nFix Version: 1.26.10,1.27.3\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2026-111943](https://nvd.nist.gov/vuln/detail/CVE-2026-111943)",
