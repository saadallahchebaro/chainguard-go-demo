            {
              "id": "CVE-2026-1485-libglib2.0-0",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-1485 low vulnerability for libglib2.0-0 package"
              },
              "fullDescription": {
                "text": "A flaw was found in Glib's content type parsing logic. This buffer underflow vulnerability occurs because the length of a header line is stored in a signed integer, which can lead to integer wraparound for very large inputs. This results in pointer underflow and out-of-bounds memory access. Exploitation requires a local user to install or process a specially crafted treemagic file, which can lead to local denial of service or application instability."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-1485",
              "help": {
                "text": "Vulnerability CVE-2026-1485\nSeverity: low\nPackage: libglib2.0-0\nVersion: 2.66.8-1\nFix Version: 2.66.8-1+deb11u8\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-1485](https://security-tracker.debian.org/tracker/CVE-2026-1485)",
