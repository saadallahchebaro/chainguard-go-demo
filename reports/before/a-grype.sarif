            {
              "id": "CVE-2026-97031-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-97031 high vulnerability for go package"
              },
              "fullDescription": {
                "text": "Multiple ECH outer extension references are not permitted under RFC 9849; previously, a client could send a well-crafted packet that could trigger memory exhaustion in the server process by specifying multiple references. We now reject these as malformed and curb the memory amplification vector as a result."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-97031",
              "help": {
                "text": "Vulnerability CVE-2026-97031\nSeverity: high\nPackage: go\nVersion: 1.18.10\nFix Version: 1.26.9,1.27.2\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2026-97031](https://nvd.nist.gov/vuln/detail/CVE-2026-97031)",
