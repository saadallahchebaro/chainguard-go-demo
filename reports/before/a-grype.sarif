            {
              "id": "CVE-2026-7010-libperl5.32",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-7010 medium vulnerability for libperl5.32 package"
              },
              "fullDescription": {
                "text": "HTTP::Tiny versions before 0.093 for Perl do not validate CRLF in HTTP request lines or control field header values.  The unvalidated inputs are the method and URI in the request line, the URL host that becomes the `Host:` header, and HTTP/1.1 control data field values.  An attacker who controls one of these inputs, for example a user supplied URL passed to a webhook or URL fetch endpoint, can inject additional headers and smuggle requests to the upstream server."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-7010",
              "help": {
                "text": "Vulnerability CVE-2026-7010\nSeverity: medium\nPackage: libperl5.32\nVersion: 5.32.1-4+deb11u2\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-7010](https://security-tracker.debian.org/tracker/CVE-2026-7010)",
