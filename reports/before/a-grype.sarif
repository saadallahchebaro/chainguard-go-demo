              }
            },
            {
              "id": "CVE-2026-35387-openssh-client",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-35387 medium vulnerability for openssh-client package"
              },
              "fullDescription": {
                "text": "OpenSSH before 10.3 can use unintended ECDSA algorithms. Listing of any ECDSA algorithm in PubkeyAcceptedAlgorithms or HostbasedAcceptedAlgorithms is misinterpreted to mean all ECDSA algorithms."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-35387",
