            {
              "id": "CVE-2026-17084-libpython3.9-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-17084 medium vulnerability for libpython3.9-minimal package"
              },
              "fullDescription": {
                "text": "The \"stringprep\" module didn't process characters from RFC 3454 tables  B.2 or B.3 correctly: the latest Unicode codepoint attributes were used  instead of the specified Unicode 3.2.0. This behavior would cause  mismatches when processing domain names using IDNA 2003 (the \"idna\"  codec) and the in_table_b2() function of the \"stringprep\" module. This  only affects domain names containing characters that were not previously  registered or had their Unicode attributes such as case-folding  behavior updated since Unicode 3.2.0."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-17084",
              "help": {
                "text": "Vulnerability CVE-2026-17084\nSeverity: medium\nPackage: libpython3.9-minimal\nVersion: 3.9.2-1\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:11\nLink: [CVE-2026-17084](https://security-tracker.debian.org/tracker/CVE-2026-17084)",
