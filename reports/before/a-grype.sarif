            {
              "id": "CVE-2026-56853-go",
              "name": "StockMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-56853 high vulnerability for go package"
              },
              "fullDescription": {
                "text": "When a server is configured to support unencrypted HTTP/2, it reads a few bytes from each new connection to see if they contain the HTTP/2 client preface. ReadHeaderTimeout is unexpectedly not being applied when doing this."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-56853",
              "help": {
                "text": "Vulnerability CVE-2026-56853\nSeverity: high\nPackage: go\nVersion: 1.18.10\nFix Version: 1.25.13,1.26.6,1.27.0-rc.3\nType: binary\nLocation: /usr/local/go/bin/go\nData Namespace: nvd:cpe\nLink: [CVE-2026-56853](https://nvd.nist.gov/vuln/detail/CVE-2026-56853)",
