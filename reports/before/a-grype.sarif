              "id": "CVE-2023-29491-libncurses6",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-29491 high vulnerability for libncurses6 package"
              },
              "fullDescription": {
