            {
              "id": "CVE-2026-119374-libsqlite3-0",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-119374 high vulnerability for libsqlite3-0 package"
              },
              "fullDescription": {
                "text": "SQLite before 3.54.0 built with FTS5 contains a heap buffer overflow in fts5DoSecureDelete() that allows attackers to write past the leaf page buffer via crafted footer key offsets. Attackers can supply a database file with a corrupted FTS5 index that, when deleted from with secure-delete enabled, corrupts heap memory and crashes the application."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-119374",
              "help": {
                "text": "Vulnerability CVE-2026-119374\nSeverity: high\nPackage: libsqlite3-0\nVersion: 3.46.1-7+deb13u2\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-119374](https://security-tracker.debian.org/tracker/CVE-2026-119374)",
