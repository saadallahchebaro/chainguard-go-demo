            {
              "id": "CVE-2026-56858-stdlib",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-56858 medium vulnerability for stdlib package"
              },
              "fullDescription": {
                "text": "Previously, pathological inputs could close an unescaped '/' early, allowing for attack-controlled data to inject arbitrary content, potentially leading to XSS."
              },
              "helpUri": "https://go.dev/issue/80435",
              "help": {
                "text": "Vulnerability CVE-2026-56858\nSeverity: medium\nPackage: stdlib\nVersion: go1.18.10\nFix Version: 1.25.13,1.26.6,1.27.0-rc.3\nType: go-module\nLocation: /usr/local/bin/hello-server\nData Namespace: govulndb:language:go\nLink: [CVE-2026-56858](https://go.dev/issue/80435)",
