     1	# Image A: single-stage. Builds and runs in the same image, golang:1.18 (Debian 11 + Go 1.18).
     2	# The baseline: what you get with the defaults. It ships everything used to build the app.
     3	# Build from the repo folder:  docker build -t hello:a -f dockerfiles/Dockerfile.a-single ./go
     4	FROM golang:1.18
     5	WORKDIR /app
     6	
     7	# Dependencies first, so this slow step stays cached when only the code changes
     8	COPY go.mod go.sum ./
     9	RUN go mod download
    10	
    11	# The code, then a static binary (no C library needed)
    12	COPY . .
    13	RUN CGO_ENABLED=0 go build -o hello-server .
    14	
    15	EXPOSE 8080
    16	# No USER line, so it runs as root
    17	CMD ["./hello-server"]
# exit 0

