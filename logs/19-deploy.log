$ C=$(crane digest localhost:5000/hello:c); echo "== image C (never signed): cosign says"; cosign verify --key cosign.pub --insecure-ignore-tlog=true localhost:5000/hello@$C 2>&1 | grep -o "no signatures found" | head -1 | sed "s/^/   /"; echo "== deploy C anyway: the same manifest, renamed hello-c, image C by digest"; sed -e "s/^  name: hello$/  name: hello-c/" -e "s/app: hello$/app: hello-c/" -e "s|hello@sha256:[0-9a-f]*|hello@$C|" k8s/deployment.yaml | kubectl apply -f - | sed "s/^/   /"; kubectl rollout status deployment/hello-c --timeout=90s | tail -1 | sed "s/^/   /"; kubectl get pods -l app=hello-c -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,READY:.status.containerStatuses[0].ready,IMAGE:.status.containerStatuses[0].imageID | sed "s/^/   /"; echo "== nothing in the cluster checked a signature. Removing hello-c:"; kubectl delete deployment hello-c | sed "s/^/   /"
