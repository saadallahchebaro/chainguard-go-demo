
===== STEP 08-image-b · 2026-11-16T09:53:08Z · chainguard

$ cat -n dockerfiles/Dockerfile.b-multi
# at 09:53:08 in /home/ubuntu/chainguard-technical-challenge
     1	# Image B: multi-stage. Builds in golang:1.18, ships only the binary on debian:trixie-slim (Debian 13).
     2	# One change from A: the runtime image. The build stage is identical, so it comes from the cache.
     3	# Build from the repo folder:  docker build -t hello:b -f dockerfiles/Dockerfile.b-multi ./go
     4	
     5	# Stage 1: build (thrown away after the build)
     6	FROM golang:1.18 AS build
     7	WORKDIR /app
     8	COPY go.mod go.sum ./
     9	RUN go mod download
    10	COPY . .
    11	RUN CGO_ENABLED=0 go build -o hello-server .
    12	
    13	# Stage 2: runtime (the only stage that ships)
    14	FROM debian:trixie-slim
    15	# Only the static binary crosses over: no compiler, no git, no source, no module cache
    16	COPY --from=build /app/hello-server /usr/local/bin/hello-server
    17	# Non-root by number. 65532 has no /etc/passwd entry here, so its group is 0 (root): USER 65532:65532 would fix that
    18	USER 65532
    19	EXPOSE 8080
    20	ENTRYPOINT ["/usr/local/bin/hello-server"]
# exit 0

