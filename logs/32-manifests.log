$ echo "== 1. the files, checked by the API server without changing anything:"; kubectl apply --dry-run=server -f k8s/; echo "== 2. kubectl diff: the files against what the cluster runs"; kubectl diff -f k8s/ > /tmp/k8s.diff; echo "   exit $?, $(wc -l < /tmp/k8s.diff) lines of difference"; echo "== 3. the digest in the file, in the cluster, and on hello:d in the registry"; F=$(grep -o "sha256:[0-9a-f]*" k8s/deployment.yaml); echo "   file:     $F"; echo "   cluster:  $(kubectl get deploy hello -o jsonpath={.spec.template.spec.containers[0].image} | grep -o "sha256:.*")"; echo "   registry: $(crane digest localhost:5000/hello:d)"; echo "== 4. that digest, signed with the lab key:"; cosign verify --key cosign.pub --insecure-ignore-tlog=true localhost:5000/hello@$F >/dev/null 2>&1; echo "   cosign verify exit $?"
