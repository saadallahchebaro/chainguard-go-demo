===== k8s/deployment.yaml
     1	# Image D on the k3s cluster: two copies, pulled from the lab registry by the digest that was scanned and signed
     2	# (a tag can move; a digest can't). The settings below meet Kubernetes' "restricted" Pod Security Standard,
     3	# which the default namespace enforces (kubectl label namespace default pod-security.kubernetes.io/enforce=restricted).
     4	apiVersion: apps/v1
     5	kind: Deployment
     6	metadata:
     7	  name: hello
     8	  labels:
     9	    app: hello
    10	spec:
    11	  replicas: 2
    12	  selector:
    13	    matchLabels:
    14	      app: hello
    15	  template:
    16	    metadata:
    17	      labels:
    18	        app: hello
    19	    spec:
    20	      # The app never calls the Kubernetes API, so its pods get no API token
    21	      automountServiceAccountToken: false
    22	      securityContext:
    23	        runAsNonRoot: true          # works because the image's user is numeric (USER 65532)
    24	        runAsUser: 65532
    25	        runAsGroup: 65532
    26	        seccompProfile:
    27	          type: RuntimeDefault      # the container runtime's default system-call filter
    28	      containers:
    29	        - name: hello
    30	          image: 192.168.252.2:5000/hello@sha256:c5ce9ddb3a8db38d7ef61bdd6c84905bd1d3e7ef61a3c51bbd0d6d7aa7270a08
    31	          imagePullPolicy: IfNotPresent
    32	          ports:
    33	            - containerPort: 8080
    34	          securityContext:
    35	            allowPrivilegeEscalation: false
    36	            readOnlyRootFilesystem: true
    37	            capabilities:
    38	              drop: ["ALL"]
    39	          resources:
    40	            requests: { cpu: 50m, memory: 32Mi }
    41	            limits: { cpu: 200m, memory: 64Mi }
    42	          readinessProbe:
    43	            httpGet: { path: /, port: 8080 }
    44	          livenessProbe:
    45	            httpGet: { path: /, port: 8080 }

===== k8s/service.yaml
     1	# One stable in-cluster address for the hello pods (ClusterIP). Reached from the build VM with kubectl port-forward.
